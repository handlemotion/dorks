{
  "name": "dorks",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only server",
    "dev:web": "pnpm --filter @dorks/web dev",
    "dev:mock": "pnpm --filter @dorks/web dev:mock",
    "dev:desktop": "pnpm --filter @dorks/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "e2e": "node scripts/e2e.mjs all",
    "e2e:server": "node scripts/e2e.mjs server",
    "e2e:web": "node scripts/e2e.mjs web"
  }
}
