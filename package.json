{
  "name": "dorks",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "env:init": "node scripts/env-init.mjs",
    "dev": "bash scripts/with-env.sh pnpm --parallel --filter @dorks/convex --filter @dorks/web dev",
    "dev:backend": "bash scripts/dev-backend.sh",
    "dev:up": "bash scripts/dev-up.sh up",
    "dev:status": "bash scripts/dev-up.sh status",
    "dev:wait": "bash scripts/dev-up.sh wait",
    "dev:down": "bash scripts/dev-up.sh down",
    "dev:sim": "bash scripts/with-env.sh env CONVEX_URL=http://127.0.0.1:3210 node infra/bridge-sim/host.mjs",
    "dev:mail": "node apps/convex/scripts/dev-mail.mjs",
    "dev:convex": "bash scripts/with-env.sh pnpm --filter @dorks/convex dev",
    "dev:web": "bash scripts/with-env.sh pnpm --filter @dorks/web dev:direct",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test"
  }
}
