{
  "name": "dorks",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only server",
    "dev:web": "pnpm --filter @dorks/web dev",
    "dev:mock": "pnpm --filter @dorks/web dev:mock",
    "dev:desktop": "pnpm --filter @dorks/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.2"
}
