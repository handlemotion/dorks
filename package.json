{
  "name": "dorks",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node scripts/dev.mjs --only server",
    "dev:web": "pnpm --filter @dorks/web dev",
    "dev:mock": "pnpm --filter @dorks/web dev:mock",
    "dev:desktop": "pnpm --filter @dorks/desktop dev",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "e2e": "node scripts/e2e.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node apps/desktop/scripts/sync-version.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "vite-plus": "catalog:",
    "ws": "^8.22.2"
  },
  "packageManager": "pnpm@12.4.2"
}
