{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Dorks",
  "colors": {
    "primary": "#3b6be8",
    "light": "#6f93f0",
    "dark": "#3b6be8"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://dorks.build"
  },
  "fonts": {
    "family": "Geist"
  },
  "navigation": {
    "groups": [
      {
        "group": "Get started",
        "pages": ["index", "quickstart"]
      },
      {
        "group": "Working with Dorks",
        "pages": ["sessions", "pull-requests", "builds", "automations", "customize", "iphone"]
      },
      {
        "group": "Reference",
        "pages": ["security", "from-source"]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "GitHub",
          "href": "https://github.com/handlemotion/dorks",
          "icon": "github"
        },
        {
          "anchor": "Releases",
          "href": "https://github.com/handlemotion/dorks/releases",
          "icon": "download"
        }
      ]
    }
  },
  "navbar": {
    "links": [
      {
        "label": "dorks.build",
        "href": "https://dorks.build"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/handlemotion/dorks"
    }
  },
  "contextual": {
    "options": ["copy", "view", "claude", "chatgpt", "mcp", "cursor", "vscode"]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/handlemotion/dorks"
    }
  }
}
