{
  "include": ["**/*.ts", "**/*.tsx", "../convex/types/*.d.ts"],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "paths": {
      "#/*": ["./src/*"],
      "@/*": ["./src/*"]
    },
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [
        "./worker-configuration.d.ts",
        "node",
        "vite/client"
    ],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": false, // normalize.ts (carried over from apps/api) is pulled in through the Convex api types
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
