{
  "name": "@dorks/desktop",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:sidecar": "node scripts/prepare-sidecar.mjs",
    "prepare:ui": "node scripts/prepare-ui.mjs",
    "prepare:all": "pnpm prepare:sidecar && pnpm prepare:ui",
    "prepare:stub": "node scripts/prepare-sidecar.mjs --stub && node scripts/prepare-ui.mjs --placeholder",
    "dev": "pnpm prepare:all && tauri dev",
    "build": "pnpm prepare:all && tauri build",
    "build:dev": "pnpm prepare:all && tauri build --debug --bundles app",
    "typecheck": "node scripts/cargo.mjs clippy -p dorks-shell-core --all-targets -- -D warnings",
    "test": "node scripts/cargo.mjs test -p dorks-shell-core",
    "check:app": "node scripts/cargo.mjs clippy --workspace --all-targets -- -D warnings && node scripts/cargo.mjs test --workspace",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
