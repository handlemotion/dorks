---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /** Pages behind a sign-in (login, invites): out of search results, no smooth scrolling. */
  app?: boolean;
}
const { title, description, app = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en" class:list={[app && "overscroll-none"]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {app && <meta name="robots" content="noindex" />}
    {app && <meta name="color-scheme" content="light dark" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/Geist-Variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/GeistSerif-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL("/og.jpg", Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class:list={[app && "overscroll-none"]}>
    <slot />
    {
      !app && (
        <script>
          import { getLenis } from "../lib/lenis";

          getLenis();
        </script>
      )
    }
  </body>
</html>
