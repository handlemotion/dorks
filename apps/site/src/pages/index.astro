---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";

const DOWNLOAD = "https://github.com/handlemotion/dorks/releases/latest";
const GITHUB = "https://github.com/handlemotion/dorks";

const pillars = [
  {
    title: "Your own sandboxes",
    body: "Each task gets a Linux machine in your Boat account, with a desktop, Chrome, git and gh. It sleeps when idle and wakes when something needs the agent.",
  },
  {
    title: "Pull requests to merge",
    body: "The agent opens PRs and stays on them: it fixes failing CI, answers review comments and resolves conflicts. It never merges by itself.",
  },
  {
    title: "Followed to production",
    body: "After the merge, the chat follows the deploy, and the agent checks the change on the live URL. If the ship fails, it opens a fix.",
  },
];

const features = [
  ["Builds", "Machines with your tools, variables and repositories ready at boot. An agent can draft the setup; you approve it."],
  ["Automations", "Instructions that run on a schedule, on pull requests and issues, or when Sentry sees trouble."],
  ["Skills and MCP", "Paste a skill or a server once. Every agent, in every sandbox, gets it."],
  ["Computer", "Watch the agent's desktop live and take over when it needs a hand."],
  ["Previews", "Dev servers open beside the chat. Comment on an element and the agent answers in place."],
  ["iPhone", "Your chats, PRs and slide to merge, through your Mac."],
];
---

<Base title="Dorks: coding agents that see their pull requests through" description="Run Claude Code in your own cloud sandboxes from one Mac app: a chat per task, and PRs the agent keeps working on until they merge.">
  <header class="wrap nav">
    <a class="brand" href="/"><Mark /> Dorks</a>
    <nav>
      <a href="/docs">Docs</a>
      <a href={GITHUB}>GitHub</a>
      <a class="button primary" href={DOWNLOAD}>Download</a>
    </nav>
  </header>

  <main>
    <section class="wrap hero">
      <h1>Coding agents that see their pull requests through.</h1>
      <p class="lede">
        Run Claude Code in your own cloud sandboxes from one Mac app. A chat per task, and every PR it opens kept green, answered and shipped.
      </p>
      <div class="actions">
        <a class="button primary" href={DOWNLOAD}>Download for Mac</a>
        <a class="button secondary" href="/docs">Read the docs</a>
      </div>
      <p class="fine">Apple silicon. Free and open source. Bring your Boat account, Claude sign-in and GitHub login.</p>
    </section>

    <section class="wrap shot">
      <img src="/hero.webp" alt="Dorks: a session's chat beside the pull request it opened and merged" width="2160" height="1426" />
    </section>

    <section class="wrap pillars">
      {
        pillars.map((p) => (
          <div>
            <h2>{p.title}</h2>
            <p>{p.body}</p>
          </div>
        ))
      }
    </section>

    <section class="wrap how">
      <h2>Nothing is hosted for you</h2>
      <p>
        The app runs a small server on your Mac. It dials out to each sandbox's bridge, so your Mac opens no inbound port, and your keys stay encrypted on your disk. Sandboxes
        bill to your Boat account; the agent runs on your Claude plan and pushes as your GitHub login.
      </p>
    </section>

    <section class="wrap">
      <div class="features">
        {
          features.map(([title, body]) => (
            <div>
              <h3>{title}</h3>
              <p>{body}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="wrap cta">
      <h2>Start a session in a minute.</h2>
      <div class="actions">
        <a class="button primary" href={DOWNLOAD}>Download for Mac</a>
        <a class="button secondary" href="/docs/quickstart">Quickstart</a>
      </div>
    </section>
  </main>

  <footer class="wrap foot">
    <span class="brand small"><Mark size={16} /> Dorks</span>
    <nav>
      <a href="/docs">Docs</a>
      <a href={GITHUB}>GitHub</a>
      <a href={`${GITHUB}/releases`}>Releases</a>
      <a href={`${GITHUB}/blob/main/SECURITY.md`}>Security</a>
    </nav>
  </footer>
</Base>

<style>
  .nav { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .nav nav, .foot nav { display: flex; align-items: center; gap: 24px; font-size: 14px; }
  .nav nav a:not(.button), .foot nav a { color: var(--muted); }
  .nav nav a:not(.button):hover, .foot nav a:hover { color: var(--fg); }
  .brand { display: inline-flex; align-items: center; gap: 8px; font-weight: 500; font-size: 17px; }
  .brand.small { font-size: 14px; gap: 6px; }

  .hero { padding-top: 96px; padding-bottom: 56px; max-width: 820px; text-align: center; }
  .hero h1 { font-size: clamp(36px, 6vw, 60px); line-height: 1.05; }
  .lede { margin: 20px auto 0; max-width: 600px; font-size: 18px; color: var(--muted); }
  .actions { display: flex; gap: 10px; justify-content: center; margin-top: 32px; flex-wrap: wrap; }
  .fine { margin-top: 16px; font-size: 13px; color: var(--muted); }

  .shot img { display: block; width: 100%; height: auto; border-radius: 12px; border: 1px solid var(--line); }

  .pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; padding-top: 88px; padding-bottom: 88px; }
  .pillars h2 { font-size: 18px; }
  .pillars p, .features p, .how p { margin-top: 8px; color: var(--muted); font-size: 15px; }

  .how { max-width: 720px; text-align: center; padding-bottom: 72px; }
  .how h2, .cta h2 { font-size: clamp(26px, 4vw, 36px); }
  .how p { font-size: 17px; margin-top: 16px; }

  .features { display: grid; grid-template-columns: repeat(3, 1fr); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .features > div { padding: 28px; border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
  .features h3 { font-size: 15px; }

  .cta { text-align: center; padding-top: 112px; padding-bottom: 112px; }

  .foot { display: flex; align-items: center; justify-content: space-between; height: 72px; border-top: 1px solid var(--line); font-size: 14px; }

  @media (max-width: 800px) {
    .pillars, .features { grid-template-columns: 1fr; }
    .hero { padding-top: 56px; }
    .nav nav a:not(.button):first-child { display: none; }
    .foot { flex-direction: column; justify-content: center; gap: 12px; height: auto; padding-top: 24px; padding-bottom: 24px; }
  }
</style>
