---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import { NotFoundActions } from "../components/NotFoundActions";
import { builtRelease } from "../lib/built-release";

const release = await builtRelease();
---

<Base title="Not found · Dorks" description="This page doesn't exist.">
  <main class="flex min-h-screen flex-col items-center justify-center gap-5 bg-[#b7a29e] px-6 text-center text-white">
    <Mark size={32} />
    <h1 class="font-serif text-3xl font-normal">Page not found</h1>
    <NotFoundActions client:load release={release} />
  </main>
</Base>
