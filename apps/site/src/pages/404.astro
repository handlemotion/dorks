---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
---

<Base title="Not found · Dorks" description="This page doesn't exist.">
  <main class="flex min-h-screen flex-col items-center justify-center gap-5 bg-[#b7a29e] px-6 text-center text-white">
    <Mark size={32} />
    <h1 class="font-serif text-3xl font-normal">Page not found</h1>
    <a
      href="/"
      class="inline-flex h-9 items-center justify-center rounded-full bg-white px-4 text-sm font-normal text-black transition-colors hover:bg-white/90"
    >
      Go to dorks.build
    </a>
  </main>
</Base>
