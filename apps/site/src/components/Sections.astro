---
/**
 * The landing page below the hero, from Figma (Dorks, node 47:2). A shell for now: placeholder logo slots and the hero
 * screenshot standing in for the feature shots, to be swapped for real logos and per-feature captures.
 */
const LOGO_SLOTS = 5;
const SHOTS = ["right", "left", "right", "left"] as const;
---

<section aria-labelledby="trusted-heading" class="w-full border-b border-[#eaeaea]">
  <h2 id="trusted-heading" class="flex h-12 items-center justify-center border-b border-[#eaeaea] text-sm text-black">
    Trusted by the teams at
  </h2>
  <ul class="grid grid-cols-2 gap-px bg-[#eaeaea] lg:grid-cols-5">
    {
      Array.from({ length: LOGO_SLOTS }, () => (
        <li class="flex h-[160px] items-center justify-center gap-2 bg-white text-sm text-[#afafaf] last:col-span-2 lg:h-[275px] lg:last:col-span-1">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
            <path d="M7 2v10M2 7h10" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          </svg>
          Put me in
        </li>
      ))
    }
  </ul>
</section>

<section class="w-full px-6 py-[120px]">
  <div class="mx-auto flex max-w-[450px] flex-col gap-4 text-[17px] leading-[22px] text-black">
    <p>Intelligence is not the issue anymore.</p>
    <p>Models have evolved to a point where the quality of an LLM&rsquo;s work relies on the harness and tools you provide it.</p>
    <p>
      At Dorks we&rsquo;re trying to build that harness: agents that run on their own machines, with your repos, your tools and your
      review loop, so what they hand back is work you can merge.
    </p>
  </div>
</section>

<section class="w-full px-6 pt-[100px] pb-[60px]">
  <p class="text-center font-serif text-[32px] leading-[1.3] text-black sm:text-[40px]">
    Dorks is the last ADE
    <br />
    you&rsquo;ll ever install.
  </p>
</section>

<section aria-label="Dorks at work" class="w-full border-y border-[#eaeaea] px-5 sm:px-12 lg:px-[clamp(64px,6.6vw,140px)]">
  <div class="mx-auto w-full border-x border-[#eaeaea]">
    {
      SHOTS.map((side) => (
        <div class="relative h-[260px] overflow-hidden sm:h-auto sm:aspect-[1310/475] border-[#eaeaea] not-last:border-b">
          <img
            src="/hero-app.webp"
            alt=""
            width={3360}
            height={2040}
            loading="lazy"
            decoding="async"
            draggable="false"
            class:list={[
              "absolute top-[15.4%] w-full max-w-none rounded-[10px] border border-[#eaeaea] select-none",
              side === "right" ? "left-[32.4%]" : "right-[32.4%]",
            ]}
          />
        </div>
      ))
    }
  </div>
</section>

<section class="w-full border-b border-[#eaeaea] px-6 pt-[364px] pb-[60px] max-sm:pt-[200px]">
  <p class="text-center font-serif text-[32px] leading-[1.3] text-black sm:text-[40px]">
    Dorks is the last ADE
    <br />
    you&rsquo;ll ever install.
  </p>
</section>
