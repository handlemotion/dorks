{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	"name": "dorks-api",
	"main": "src/index.ts",
	"compatibility_date": "2026-10-06",
	"compatibility_flags": ["nodejs_compat"],
	"observability": { "enabled": true },
	"upload_source_maps": true,

	// D1 id is auto-provisioned on first `wrangler deploy` (or set it from `wrangler d1 create dorks`).
	"d1_databases": [{ "binding": "DB", "database_name": "dorks", "migrations_dir": "migrations" }],
	"durable_objects": { "bindings": [{ "name": "DORK", "class_name": "Dork" }] },
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Dork"] }],

	"vars": {
		"ALLOWED_EMAIL_DOMAIN": "jaantonio.com",
		"APP_URL": "http://localhost:3000",
		"BASE_SNAPSHOT_ID": "",
		"GITHUB_APP_ID": "",
		// Public https URL of this Worker, which the in-box bridge dials (wss). Local dev: unreachable from a real box.
		"API_PUBLIC_URL": "http://localhost:8787",
		// "sim" = in-memory box for local dev/tests. Anything else = real Upstash Box (once implemented).
		"BOX_PROVIDER": ""
	},
	// Set with `wrangler secret put <NAME>`; locally in apps/api/.dev.vars (see .dev.vars.example).
	"secrets": {
		"required": [
			"BETTER_AUTH_SECRET",
			"ENCRYPTION_KEY",
			"UPSTASH_BOX_API_KEY",
			"GITHUB_APP_PRIVATE_KEY",
			"GITHUB_WEBHOOK_SECRET",
			"RESEND_API_KEY",
			"EXPO_ACCESS_TOKEN"
		]
	}
}
